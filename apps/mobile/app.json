{
  "expo": {
    "name": "Reread",
    "slug": "reread",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "reread",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dongwookkang.reread",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF7",
          "image": "./assets/images/icons/splash-icon.png",
          "imageWidth": 90
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "읽던 쪽을 찍어 문장을 옮겨 적으려면 카메라가 필요해요."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "woogie-uc"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55467f8b-076e-484c-b073-f783d27e05f0"
      }
    },
    "owner": "woogie0303"
  }
}
